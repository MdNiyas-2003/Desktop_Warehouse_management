rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Username lookup is required before auth login; keep list disabled.
    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 30;
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow create, read, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }
  }
}
